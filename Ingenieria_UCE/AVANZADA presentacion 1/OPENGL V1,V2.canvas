{
	"nodes":[
		{"id":"58e502dc1fee0c3f","x":-313,"y":-172,"width":250,"height":60,"type":"text","text":"una especificacion, no un programa"},
		{"id":"3a7f405118f3cd54","x":21,"y":-300,"width":250,"height":88,"type":"text","text":"antes de 1992 cada fabricante su idioma, creado por silicon graphics,\n"},
		{"id":"c54e1da4cab15ac5","x":208,"y":-174,"width":250,"height":114,"type":"text","text":"se crea en 1192 otr tipo abiero para con implementaciones hacerlo de un solo idioma"},
		{"id":"36a2dd5643533605","x":-80,"y":-60,"width":250,"height":60,"type":"text","text":"OPEN GL V1, V2"},
		{"id":"1e2f822ce4e4a79e","x":-197,"y":79,"width":250,"height":101,"type":"text","text":"en Open GL 2.0 vertex shaders y fragment shaders con glsl"},
		{"id":"42003359dbe0b8d4","x":-3,"y":233,"width":402,"height":107,"type":"text","text":"Microsoft HLSL direct 3D Open GL permitia que cada empresa haga modificaciones en el programa"},
		{"id":"2f32c92bb56b93bf","x":333,"y":10,"width":250,"height":138,"type":"text","text":"pipeline funcion fija, sigue instrucciones que tienen configuraciones fijas es decir, activar y configurar etapas ya hechas"},
		{"id":"0099bdde6ed67bb2","x":-546,"y":133,"width":250,"height":154,"type":"text","text":"\t'Open GL 2.0 es retrocompatible sigue funcionando con sus versiones antiguas'"},
		{"id":"f9e165b92282f692","x":-240,"y":335,"width":250,"height":145,"type":"text","text":"de 1x a 2.0 \nfijo a programable\nninguno estanda a dlsl\npor vertice a por pixel"}
	],
